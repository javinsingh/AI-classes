import cv2
import matplotlib.pyplot as plt
from google.colab import files

file = files.upload()

image_source= "example.jpg"
image =cv2.imread(image_source)
rgb_image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

height, width, _ = rgb_image.shape

rect1_height, rect1_width = 150, 150
topleft1 = (20, 20)
bottomright1 = (topleft1[0] + rect1_width, topleft1[1] + rect1_height)
cv2.rectangle(rgb_image, topleft1, bottomright1, (0, 255, 255), 3)

#rect 2
rect2_height, rect2_width = 200, 150
topleft2 = (width - rect2_width - 20, height - rect2_height - 20)
bottomright2 = (topleft2[0] + rect2_width, topleft2[1] + rect2_height)
cv2.rectangle(rgb_image, topleft2, bottomright2, (255, 0, 255))

#center
center1_x = (topleft1[0] + bottomright1[0]) // 2
center2_x = (topleft2[0] + bottomright2[0]) // 2
center1_y = (topleft1[1] + bottomright1[1]) // 2
center2_y = (topleft2[1] + bottomright2[1]) // 2
cv2.circle(rgb_image, (center1_x, center1_y), 15, (255, 255, 0), -1)
cv2.circle(rgb_image, (center2_x, center2_y), 15, (255, 0, 255), -1)

cv2.line(rgb_image, (center1_x, center1_y), (center2_x, center2_y), (0, 255, 0), 3)

font = cv2.FONT_HERSHEY_SIMPLEX
cv2.putText(rgb_image, "region 1", (topleft1[0], topleft1[1] - 10), font, 0.7, (0, 0, 0), 2, cv2.LINE_AA)
cv2.putText(rgb_image, "region 2", (topleft2[0], topleft2[1] - 10), font, 0.7, (0, 0, 0), 2, cv2.LINE_AA)
cv2.putText(rgb_image, "center 1", (center1_x - 40, center1_y + 40), font, 0.7, (0, 0, 0), 2, cv2.LINE_AA)
cv2.putText(rgb_image, "center 2", (center2_x + 40, center2_y - 40), font, 0.7, (0, 0, 0), 2, cv2.LINE_AA)

arrow_start = (width - 50, 20)
arrow_end = (width - 50, height - 20)

cv2.arrowedLine(rgb_image, arrow_start, arrow_end, (0, 0, 255), 2, tipLength=1.5)
cv2.arrowedLine(rgb_image, arrow_end, arrow_start, (0, 0, 255), 2, tipLength=1.5)

height_label_position = (arrow_start[0] - 150, (arrow_start[1] + arrow_end[1]) // 2)
cv2.putText(rgb_image, "height", height_label_position, font, 0.7, (0, 0, 0), 2, cv2.LINE_AA)

plt.figure(figsize=(12, 8))
plt.imshow(rgb_image)
plt.axis("off")
plt.title("image with rectangles and cicles")
plt.show()
